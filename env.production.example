# BusTicket Production Environment Configuration
# Copy this file to .env.production and update the values
# NEVER commit this file to version control

# Application
NODE_ENV=production
VITE_API_URL=https://api.busticket.com

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_NAME=busticket
DB_SSLMODE=require

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING
JWT_EXPIRATION=24h

# CORS Configuration
CORS_ORIGIN=https://busticket.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD
REDIS_DB=0

# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=production

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@busticket.com

# Payment Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
LOG_LEVEL=warn

# Security
BCRYPT_COST=12
SESSION_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# SSL/TLS
SSL_CERT_PATH=/etc/ssl/certs/busticket.crt
SSL_KEY_PATH=/etc/ssl/private/busticket.key
