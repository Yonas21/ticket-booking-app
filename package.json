{
  "name": "bus-ticket-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:codegen": "playwright codegen",
    "docker:dev": "./scripts/docker-setup.sh development",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml --profile production up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose up --build",
    "docker:env:setup": "cp env.example .env && echo 'Please edit .env file with your actual values'",
    "docker:env:prod": "cp env.production.example .env.production && echo 'Please edit .env.production file with your production values'",
    "pre-commit:install": "pre-commit install",
    "pre-commit:update": "pre-commit autoupdate",
    "pre-commit:run": "pre-commit run --all-files"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@tanstack/react-query": "^5.0.0",
    "bootstrap": "^5.3.7",
    "framer-motion": "^11.0.0",
    "i18next": "^25.3.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.400.0",
    "playright": "^0.0.22",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "react-helmet-async": "^2.0.4",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^15.6.1",
    "react-intersection-observer": "^9.8.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.8.0",
    "react-select": "^5.8.0",
    "react-toastify": "^11.0.5",
    "swiper": "^11.0.0",
    "vite-plugin-svgr": "^4.3.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "vite": "^4.4.5"
  }
}
